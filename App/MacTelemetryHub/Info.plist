<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Mac Telemetry Hub</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>连接 Anker Prime 160W 充电器并读取端口遥测数据。</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>读取 Music.app 当前播放的歌曲、播放状态和进度，用于本机实时状态上报。</string>
    <key>NSAppleMusicUsageDescription</key>
    <string>读取你的 Apple Music 资料库权限，用于获取 Apple Music 用户令牌并同步到你配置的后端。</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>读取当前窗口标题。标题先过黑名单和 TypeSafe 模型判断：不在标题黑名单、也不在免判名单里的标题会连同应用名发送给 TypeSafe 判断能否公开；判为可公开的标题会随上报发到你配置的后端，并出现在本地 HTTP 接口的 /health 里；锁定、待确认或省略的标题不出本机。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>在本机网络提供充电器状态 API，并按配置上报遥测数据。</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
